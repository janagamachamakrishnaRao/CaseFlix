{
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": ["python312", "libreoffice", "weasyprint", "pango", "cairo", "gdk-pixbuf"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "gunicorn -w 1 -k uvicorn.workers.UvicornWorker main:app --bind 0.0.0.0:8080",
    "restartPolicyType": "ON_FAILURE"
  }
}